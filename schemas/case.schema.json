{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillbench.dev/schemas/case.schema.json",
  "title": "SkillBench case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "categories",
    "fixture",
    "promptSteps",
    "publicVerification",
    "limits",
    "allowedChangePaths",
    "forbiddenChangePaths",
    "assertions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": { "$ref": "#/$defs/fixture" },
    "promptSteps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/promptStep" }
    },
    "publicVerification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/typedCommand" }
    },
    "limits": { "$ref": "#/$defs/runtimeLimits" },
    "allowedChangePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "forbiddenChangePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "transcriptRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transcriptRule" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\0]+$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contentHash"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventRuleIds"],
      "properties": {
        "eventRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "promptStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prompt": { "type": "string", "minLength": 1 },
        "continuation": { "$ref": "#/$defs/continuation" }
      }
    },
    "typedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "args"],
      "properties": {
        "executor": { "enum": ["node", "npm", "git"] },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtimeLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallClockMs", "outputBytes", "tokenLimit"],
      "properties": {
        "wallClockMs": { "type": "integer", "minimum": 1 },
        "outputBytes": { "type": "integer", "minimum": 1 },
        "tokenLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "critical"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dimension": {
          "enum": ["functional", "regression", "security", "scope", "process"]
        },
        "critical": { "type": "boolean" }
      }
    },
    "commandMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "executor", "argsPrefix"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "check": { "enum": ["command_ran", "command_before_file_change", "command_after_file_change"] },
        "executor": { "type": "string", "minLength": 1 },
        "argsPrefix": { "type": "array", "items": { "type": "string" } },
        "expect": { "type": "boolean" }
      }
    },
    "eventPresence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "check": { "enum": ["no_file_change", "assistant_message"] },
        "expect": { "type": "boolean" }
      }
    },
    "transcriptRule": {
      "oneOf": [
        { "$ref": "#/$defs/eventPresence" },
        { "$ref": "#/$defs/commandMatcher" }
      ]
    }
  }
}
